# {{ ansible_managed }}
# Paypure production stack (infra/ansible). Only the client publishes a port.
name: {{ compose_project }}

x-common: &common
  restart: unless-stopped
  init: true
  security_opt: ["no-new-privileges:true"]
  logging:
    driver: json-file
    options: { max-size: 5m, max-file: "3" }

services:
  postgres:
    <<: *common
    image: {{ postgres_image }}
    environment:
      POSTGRES_USER: paypure
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      POSTGRES_DB: paypure
      TZ: UTC
    command: >
      postgres -c shared_buffers=128MB -c work_mem=4MB
               -c max_connections=40 -c effective_cache_size=384MB
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U paypure -d paypure"]
      interval: 5s
      retries: 30
    deploy: { resources: { limits: { memory: {{ mem_postgres }} } } }

  # One-shot: migrations run as the table owner, never on app boot (Tech §7.2).
  api-migrate:
    <<: *common
    image: paypure-api:${API_TAG:?}
    restart: "no"
    command: ["node_modules/.bin/prisma", "migrate", "deploy"]
    environment:
      DATABASE_URL: postgresql://paypure:${POSTGRES_PASSWORD}@postgres:5432/paypure
    depends_on:
      postgres: { condition: service_healthy }
    deploy: { resources: { limits: { memory: 256m } } }

  api:
    <<: *common
    image: paypure-api:${API_TAG:?}
    environment:
      TZ: UTC
      NODE_ENV: production
      PORT: 4000
      DATABASE_URL: postgresql://paypure:${POSTGRES_PASSWORD}@postgres:5432/paypure
      APP_DATABASE_URL: postgresql://paypure_app:${APP_DB_PASSWORD:?}@postgres:5432/paypure
      CLIENT_INTERNAL_URL: http://client:3000
      PUBLIC_URL: ${PUBLIC_URL:?}
      PUBLIC_INVOICE_LINKS: ${PUBLIC_INVOICE_LINKS:-false}
      GOTENBERG_URL: http://gotenberg:3000
      MAIL_TRANSPORT: ${MAIL_TRANSPORT:-log}
      SMTP_URL: ${SMTP_URL:-}
      SMTP_USER: ${SMTP_USER:-}
      SMTP_PASS: ${SMTP_PASS:-}
      MAIL_FROM: ${MAIL_FROM:-}
      MAIL_REDIRECT_TO: ${MAIL_REDIRECT_TO:-}
      SESSION_SECRET: ${SESSION_SECRET:?}
      PRINT_SIGNING_SECRET: ${PRINT_SIGNING_SECRET:?}
      NODE_OPTIONS: --max-old-space-size=256
    healthcheck:
      test: ["CMD", "node", "-e", "require('net').connect(4000,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]
      interval: 10s
      retries: 12
      start_period: 20s
    depends_on:
      postgres: { condition: service_healthy }
      api-migrate: { condition: service_completed_successfully }
      gotenberg: { condition: service_started }
    deploy: { resources: { limits: { memory: {{ mem_api }} } } }

  client:
    <<: *common
    image: paypure-client:${CLIENT_TAG:?}
    environment:
      TZ: UTC
      NODE_ENV: production
      API_URL: http://api:4000
      PUBLIC_URL: ${PUBLIC_URL:?}
      PRINT_SIGNING_SECRET: ${PRINT_SIGNING_SECRET:?}
      NODE_OPTIONS: --max-old-space-size=256
    ports: ["{{ paypure_port }}:3000"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
      interval: 15s
      retries: 12
      start_period: 20s
    depends_on:
      api: { condition: service_healthy }
    deploy: { resources: { limits: { memory: {{ mem_client }} } } }

  gotenberg:
    <<: *common
    image: {{ gotenberg_image }}
    command: ["gotenberg", "--chromium-restart-after=50", "--api-timeout=30s"]
    deploy: { resources: { limits: { memory: {{ mem_gotenberg }} } } }

volumes:
  pgdata: {}
