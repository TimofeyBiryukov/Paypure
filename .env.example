# Copy to .env (git-ignored). docker compose reads it automatically.
# Nothing here is required: without a .env, emails go to the API log.

# --- Email -----------------------------------------------------------
# log  = write each email to `docker compose logs api` (default)
# smtp = really send it, over SMTP_URL
MAIL_TRANSPORT=log

# Gmail (personal account + App Password), see docs/email-setup.md
# SMTP_URL=smtps://smtp.gmail.com:465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcdefghijklmnop

# From address. Defaults to SMTP_USER. With Gmail it must be that
# account or a verified "Send mail as" alias.
# MAIL_FROM=you@gmail.com

# Safety net while testing: every email goes here instead of to the
# client. Remove it to send to real recipients.
# MAIL_REDIRECT_TO=you@gmail.com

# Mailpit instead (catches mail in a web UI on :8025):
#   docker compose --profile mail up -d mailpit
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtp://mailpit:1025

# --- Public invoice pages ---------------------------------------------
# Lets clients open an invoice at PUBLIC_URL/i/<token> without logging
# in, and adds a "view it online" link to emails. Off by default: on a
# private network (Tailscale) clients can't reach that link anyway.
# Lines in email templates that use {{link}} are dropped while it's off.
# PUBLIC_INVOICE_LINKS=true
# PUBLIC_URL=https://invoices.example.com
